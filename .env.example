# Sovereign AI Workbench — environment defaults
# Copy this to .env and adjust if needed (do NOT commit .env)

# ─── Postgres ───────────────────────────────────────────────────────
POSTGRES_DB=sovereign
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign_pass

# ─── Application (matches docker-compose.yml) ───────────────────────
DATABASE_URL=postgresql+asyncpg://sovereign:sovereign_pass@postgres:5432/sovereign
SYNC_DATABASE_URL=postgresql+psycopg://sovereign:sovereign_pass@postgres:5432/sovereign
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

# ─── Storage paths (inside containers) ──────────────────────────────
UPLOADS_DIR=/data/uploads
KNOWLEDGE_DIR=/data/knowledge
WORKSPACES_DIR=/data/workspaces
ARTIFACTS_DIR=/data/artifacts
SANDBOX_QUEUE_DIR=/sandbox_queue

# ─── Model cache (offline) ──────────────────────────────────────────
HF_HOME=/data/knowledge/.hf_cache
TRANSFORMERS_OFFLINE=1

# ─── Security ───────────────────────────────────────────────────────
SECRET_KEY=change-me-for-production-this-is-demo-only
